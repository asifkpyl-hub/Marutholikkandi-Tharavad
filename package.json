{
  "name": "marutholikkandi-tharavad",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create marutholikkandi-family-db",
    "db:migrate:local": "wrangler d1 execute marutholikkandi-family-db --local --file=./migrations/0001_initial.sql",
    "db:migrate:remote": "wrangler d1 execute marutholikkandi-family-db --remote --file=./migrations/0001_initial.sql"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
